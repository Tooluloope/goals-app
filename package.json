{
  "name": "goals-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "turbo run dev --filter=@goals/web",
    "dev:api": "turbo run dev --filter=@goals/api",
    "db:generate": "turbo run db:generate --filter=@goals/database",
    "db:push": "turbo run db:push --filter=@goals/database",
    "db:migrate": "turbo run db:migrate --filter=@goals/database",
    "db:seed": "turbo run db:seed --filter=@goals/database",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18"
  }
}
