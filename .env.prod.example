# Production Environment Configuration
# Copy this file to .env.prod and fill in the values

# ===========================================
# DATABASE
# ===========================================
DB_USER=goals_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth Secret (used for JWT signing)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET

# ===========================================
# API CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=https://alignia.xyz,https://app.alignia.xyz

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# API URL for the web app (internal Docker network)
NEXT_PUBLIC_API_URL=http://api:3001

# App URL for email links (external URL)
NEXT_PUBLIC_APP_URL=https://app.alignia.xyz

# Marketing site URL (for redirects)
NEXT_PUBLIC_MARKETING_URL=https://alignia.xyz

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Alignia

# ===========================================
# AI (Anthropic) - Optional
# ===========================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=2000
