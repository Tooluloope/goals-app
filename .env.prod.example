# ===========================================
# ROOT PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# This file contains shared configuration for production deployment.
# Each app has its own .env.prod.example file in apps/{api,web,marketing}/.env.prod.example
#
# For production: Use app-specific .env files for each service

# ===========================================
# SHARED DATABASE (Production)
# ===========================================
# PostgreSQL credentials for production
# Used by: API, Scheduler, Database migrations
DB_USER=goals_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=goals_db
DB_PORT=5432

# ===========================================
# INSTRUCTIONS
# ===========================================
# For production deployment:
# 1. Configure app-specific environment files:
#    - apps/api/.env (API server configuration)
#    - apps/web/.env (Web app configuration)
#    - apps/marketing/.env (Marketing site configuration)
# 2. Or use environment variables directly in your deployment platform
# 3. Ensure DATABASE_URL is set correctly for API and scheduler services
# 4. Use app-specific .env.prod.example as templates for each service
