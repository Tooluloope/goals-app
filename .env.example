# ===========================================
# ROOT ENVIRONMENT CONFIGURATION
# ===========================================
# This file contains shared configuration for local development.
# Each app has its own .env.example file in apps/{api,web,marketing}/.env.example
#
# For development: Copy this to .env and configure your local database
# For production: Use app-specific .env files instead

# ===========================================
# SHARED DATABASE (Local Development)
# ===========================================
# PostgreSQL connection for local development
# Used by: API, Database migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/goals_db

# Database credentials (for docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goals_db
DB_PORT=5433

# ===========================================
# INSTRUCTIONS
# ===========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Copy app-specific env files:
#    - cp apps/api/.env.example apps/api/.env
#    - cp apps/web/.env.example apps/web/.env
#    - cp apps/marketing/.env.example apps/marketing/.env
# 3. Configure each app's .env file with appropriate values
# 4. Run: docker compose up -d postgres (to start database)
# 5. Run: pnpm dev (to start all apps in development mode)
