# Production Environment Configuration for API
# Copy this file to .env or .env.prod and fill in the values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://goals_prod_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/goals_db
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# SERVER CONFIGURATION
# ===========================================
API_PORT=3001
NODE_ENV=production

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=https://alignia.xyz,https://app.alignia.xyz
CORS_ALLOW_ALL=false

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth Secret (used for JWT signing)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@alignia.app
EMAIL_FROM_NAME=Alignia

# App URL (for email links)
NEXT_PUBLIC_APP_URL=https://app.alignia.xyz

# Logo URL (for emails)
APP_LOGO_URL=https://www.alignia.xyz/logo.png

# ===========================================
# AI (Anthropic Claude)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=2000

# ===========================================
# STRIPE (Billing & Subscriptions)
# ===========================================
# Get your LIVE keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Stripe Price IDs (from Stripe Dashboard Products)
STRIPE_FREE_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_FAMILY_PRICE_ID=price_xxxxxxxxxxxx

# Trial Configuration
TRIAL_PERIOD_DAYS=14

# ===========================================
# SCHEDULER (Optional - only for scheduler service)
# ===========================================
ENABLE_SCHEDULER=false
