# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/goals_db

# ===========================================
# SERVER CONFIGURATION
# ===========================================
API_PORT=3001
NODE_ENV=development

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3008,http://localhost:3000
CORS_ALLOW_ALL=false

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth Secret (used for JWT signing)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-generate-with-openssl

# Super admin seeding (first login gets SUPER_ADMIN role)
SUPER_ADMIN_EMAIL=adetulatolu@gmail.com

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Alignia
# Minimum delay between emails (ms). 500ms = 2 emails/sec.
EMAIL_MIN_INTERVAL_MS=500

# App URL (for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3008

# Logo URL (for emails)
APP_LOGO_URL=https://www.alignia.xyz/logo.png

# ===========================================
# AI (Anthropic Claude)
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=2000

# ===========================================
# STRIPE (Billing & Subscriptions)
# ===========================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create products in Stripe Dashboard)
# Free plan (no charge)
STRIPE_FREE_PRICE_ID=price_free_plan_id
# Pro plan ($7/month)
STRIPE_PRO_PRICE_ID=price_pro_plan_id
# Family plan ($14/month)
STRIPE_FAMILY_PRICE_ID=price_family_plan_id

# Trial Configuration
TRIAL_PERIOD_DAYS=14

# ===========================================
# REDIS (Optional - for rate limiting & caching)
# ===========================================
# Local: redis://localhost:6379
# Upstash: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ===========================================
# SCHEDULER (Optional - only for scheduler service)
# ===========================================
ENABLE_SCHEDULER=false
