# Production Environment Configuration for Web App
# Copy this file to .env or .env.prod and fill in the values

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API URL (internal Docker network)
NEXT_PUBLIC_API_URL=http://api:3001

# ===========================================
# APP CONFIGURATION
# ===========================================
# Web app URL (external URL for redirects and links)
NEXT_PUBLIC_APP_URL=https://app.alignia.xyz

# Marketing site URL
NEXT_PUBLIC_MARKETING_URL=https://alignia.xyz

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
NEXTAUTH_URL=https://app.alignia.xyz

# ===========================================
# STRIPE (Client-side)
# ===========================================
# Get your LIVE publishable key from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
