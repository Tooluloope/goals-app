# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================
# APP CONFIGURATION
# ===========================================
# Web app URL (for redirects and links)
NEXT_PUBLIC_APP_URL=http://localhost:3008

# Marketing site URL
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-generate-with-openssl
NEXTAUTH_URL=http://localhost:3008

# ===========================================
# STRIPE (Client-side)
# ===========================================
# Get your publishable key from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
