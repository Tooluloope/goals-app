#!/usr/bin/env sh

# Run lint-staged (prettier + eslint on staged files)
pnpm lint-staged

# Type check the entire project
echo "Running type checks..."
pnpm typecheck

# Run tests related to changed files (no coverage)
echo "Running tests..."
npx jest --passWithNoTests --bail --coverage=false --findRelatedTests $(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' | tr '\n' ' ')
