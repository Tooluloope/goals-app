generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  hasSetPassword     Boolean   @default(true) // false for users who signed up via magic link
  name               String
  avatar             String?
  defaultWorkspaceId String?
  timezone           String    @default("UTC") // IANA timezone string (e.g., "America/New_York")
  settings           Json      @default("{\"theme\": \"light\", \"compactMode\": false, \"showWelcomeOnLogin\": true, \"emailPreferences\": {\"habitReminders\": true, \"taskDueReminders\": true, \"weeklySummary\": true, \"monthlySummary\": true, \"staleProjectAlerts\": true, \"reviewDueReminders\": true, \"streakMilestones\": true, \"aiInsights\": true, \"inactivityReminders\": false}}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  ownedProjects        Project[]             @relation("OwnedProjects")
  workspaceMemberships WorkspaceMember[]
  sentInvites          WorkspaceInvite[]     @relation("SentInvites")
  notifications        Notification[]
  assignedTasks        Task[]                @relation("AssignedTasks")
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  magicLinkTokens      MagicLinkToken[]
  journalEntries       JournalEntry[]
  habits               Habit[]
  weeklyReviews        WeeklyReview[]
  monthlyReviews       MonthlyReview[]
  // AI features
  aiSummaries          AiSummary[]
  aiConversations      AiConversation[]
  aiInsights           AiInsight[]
  aiDailyTexts         AiDailyText[]
  // Review notes
  createdReviewNotes   ReviewNote[]      @relation("CreatedReviewNotes")
  // NextAuth relations
  accounts             Account[]
  sessions             Session[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String   // Email to send the link to (may not have account yet)
  name      String?  // Optional - name for new user signup
  userId    String?  // Optional - null if user doesn't exist yet
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

// NextAuth.js required models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// WORKSPACE
// ============================================================

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType @default(personal)
  ownerId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  owner   User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  projects Project[]
  config   WorkspaceConfig?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  workspaceId String
  userId      String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String       @id @default(uuid())
  workspaceId String
  email       String       // Email of the invited user
  token       String       @unique
  invitedById String       // User who sent the invite
  role        MemberRole   @default(member)
  status      InviteStatus @default(pending)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([status])
}

enum InviteStatus {
  pending
  accepted
  expired
  cancelled
}

enum WorkspaceType {
  personal
  family
}

enum MemberRole {
  owner
  admin
  member
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  statusId        String
  areaIds         String[]  @default([])
  startDate       DateTime
  targetDate      DateTime
  cadenceId       String
  priorityId      String
  successMetric   String
  lastReviewDate  DateTime?
  confidenceId    String
  objective       String    @db.Text
  failureCriteria String?   @db.Text
  tagIds          String[]  @default([])
  ownerId         String?   // Owner of the goal (for multi-member workspaces)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User?             @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  checklistItems ChecklistItem[]
  keyDecisions   KeyDecision[]
  tasks          Task[]
  metrics        ProjectMetrics?
  reviewNotes    ReviewNote[]
  images         ImageAttachment[] @relation("ProjectImages")
  notifications  Notification[]
  // Dependency relations
  blockedBy      ProjectDependency[] @relation("DependentProjects")
  blocking       ProjectDependency[] @relation("BlockingProjects")

  @@index([workspaceId])
  @@index([statusId])
  @@index([ownerId])
}

model ChecklistItem {
  id        String            @id @default(uuid())
  projectId String
  type      ChecklistItemType
  text      String
  completed Boolean           @default(false)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum ChecklistItemType {
  requirement
  definition_of_done
}

model KeyDecision {
  id        String   @id @default(uuid())
  projectId String
  date      DateTime
  context   String   @db.Text
  options   String[]
  chosen    String
  rationale String   @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ReviewNote {
  id          String   @id @default(uuid())
  projectId   String
  createdById String?
  date        DateTime
  notes       String   @db.Text
  progress    String   @db.Text
  blockers    String   @db.Text
  changes     String   @db.Text
  nextStep    String   @db.Text
  createdAt   DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("CreatedReviewNotes", fields: [createdById], references: [id], onDelete: SetNull)
  images    ImageAttachment[] @relation("ReviewImages")

  @@index([projectId])
  @@index([createdById])
}

model ProjectMetrics {
  id               String  @id @default(uuid())
  projectId        String  @unique
  primaryMetric    String?
  leadingIndicator String?
  riskIndicator    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// TASK
// ============================================================

model Task {
  id           String    @id @default(uuid())
  projectId    String
  title        String
  statusId     String
  dueDate      DateTime?
  assignedToId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Recurrence fields
  isRecurring        Boolean         @default(false)
  recurrenceType     RecurrenceType  @default(none)
  recurrenceInterval Int             @default(1)
  recurrenceDays     Int[]           @default([]) // 0=Sun, 1=Mon, ..., 6=Sat for weekly
  nextOccurrence     DateTime?
  parentTaskId       String?
  completedAt        DateTime?
  streak             Int             @default(0)

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo    User?             @relation("AssignedTasks", fields: [assignedToId], references: [id])
  images        ImageAttachment[] @relation("TaskImages")
  notifications Notification[]
  parentTask    Task?             @relation("RecurringTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks    Task[]            @relation("RecurringTasks")
  // Dependency relations
  blockedBy     TaskDependency[]  @relation("DependentTasks")
  blocking      TaskDependency[]  @relation("BlockingTasks")

  @@index([projectId])
  @@index([statusId])
  @@index([assignedToId])
  @@index([parentTaskId])
  @@index([isRecurring])
}

// ============================================================
// PROJECT DEPENDENCIES
// ============================================================

model ProjectDependency {
  id          String   @id @default(uuid())
  dependentId String   // Project that is blocked
  blockerId   String   // Project that is blocking
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  dependent Project @relation("DependentProjects", fields: [dependentId], references: [id], onDelete: Cascade)
  blocker   Project @relation("BlockingProjects", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([dependentId, blockerId])
  @@index([dependentId])
  @@index([blockerId])
}

// ============================================================
// TASK DEPENDENCIES
// ============================================================

model TaskDependency {
  id          String   @id @default(uuid())
  dependentId String   // Task that is blocked
  blockerId   String   // Task that is blocking
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  dependent Task @relation("DependentTasks", fields: [dependentId], references: [id], onDelete: Cascade)
  blocker   Task @relation("BlockingTasks", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([dependentId, blockerId])
  @@index([dependentId])
  @@index([blockerId])
}

enum RecurrenceType {
  none
  daily
  weekly
  monthly
  yearly
  custom
}

// ============================================================
// IMAGE ATTACHMENT
// ============================================================

model ImageAttachment {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  caption   String?
  createdAt DateTime @default(now())

  // Polymorphic relations
  projectId    String?
  taskId       String?
  reviewNoteId String?

  project    Project?    @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation("TaskImages", fields: [taskId], references: [id], onDelete: Cascade)
  reviewNote ReviewNote? @relation("ReviewImages", fields: [reviewNoteId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([reviewNoteId])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  projectId String?
  taskId    String?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, readAt])
}

enum NotificationType {
  DueSoon
  Overdue
  ReviewDue
  StaleProject
  DailyFocus
  BlockerResolved
}

// ============================================================
// WORKSPACE CONFIG
// ============================================================

model WorkspaceConfig {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ============================================================
// DAILY JOURNAL
// ============================================================

model JournalEntry {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  mood        Mood?
  emoji       String?  // User-selected emoji for the day
  prompt      String?  @db.Text
  content     String   @db.Text
  wins        String?  @db.Text
  challenges  String?  @db.Text
  gratitude   String?  @db.Text
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

enum Mood {
  terrible
  bad
  neutral
  good
  great
}

// ============================================================
// HABIT TRACKER
// ============================================================

model Habit {
  id              String         @id @default(uuid())
  userId          String
  name            String
  icon            String         // Lucide icon name or emoji
  color           String         @default("primary") // Tailwind color name
  order           Int            @default(0)
  isArchived      Boolean        @default(false)
  // Frequency settings
  frequency       HabitFrequency @default(daily)
  frequencyDays   Int[]          @default([]) // 0=Sun, 1=Mon, ..., 6=Sat for specific days
  // Reminder settings
  reminderEnabled Boolean        @default(false)
  reminderTime    String?        // HH:MM format
  // Goal area (optional categorization)
  goalArea        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
  @@index([userId, isArchived])
}

enum HabitFrequency {
  daily
  weekly
  specific_days
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime @db.Date
  completed Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

// ============================================================
// WEEKLY & MONTHLY REVIEWS
// ============================================================

model WeeklyReview {
  id             String   @id @default(uuid())
  userId         String
  weekStart      DateTime @db.Date // Monday of the week
  wentWell       String?  @db.Text
  toImprove      String?  @db.Text
  focusNextWeek  String?  @db.Text
  lessonsLearned String?  @db.Text
  gratitude      String?  @db.Text
  rating         Int?     // 1-5 star rating
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([weekStart])
}

model MonthlyReview {
  id                String   @id @default(uuid())
  userId            String
  month             DateTime @db.Date // First day of month
  highlights        String?  @db.Text
  challenges        String?  @db.Text
  goalsAchieved     String?  @db.Text
  goalsForNextMonth String?  @db.Text
  lessonsLearned    String?  @db.Text
  gratitude         String?  @db.Text
  rating            Int?     // 1-5 star rating
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
}

// ============================================================
// AI FEATURES
// ============================================================

model AiSummary {
  id          String      @id @default(uuid())
  userId      String
  workspaceId String
  type        SummaryType
  periodStart DateTime    @db.Date
  periodEnd   DateTime    @db.Date
  content     String      @db.Text
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, type, periodStart])
  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([periodStart])
}

enum SummaryType {
  weekly
  monthly
  yearly
}

model AiConversation {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

model AiMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

enum MessageRole {
  user
  assistant
}

model AiInsight {
  id          String      @id @default(uuid())
  userId      String
  workspaceId String
  type        InsightType
  title       String
  content     String      @db.Text
  confidence  Float
  actionable  Boolean     @default(true)
  dismissed   Boolean     @default(false)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([dismissed])
  @@index([createdAt])
}

enum InsightType {
  pattern
  recommendation
  celebration
  warning
  milestone
}

// Daily motivational text - cached per user per workspace per day
model AiDailyText {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  date        DateTime @db.Date
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, date])
  @@index([userId])
  @@index([workspaceId])
  @@index([date])
}
